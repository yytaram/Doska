generator client {
  provider = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AdStatus {
  DRAFT
  MODERATION
  ACTIVE
  PAUSED
  CLOSED
  REJECTED
  EXPIRED
}

enum ItemCondition {
  ANY
  NEW
  LIKE_NEW
  GOOD
  FAIR
  FOR_PARTS
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ReportTargetType {
  USER
  AD
  OFFER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ModerationSeverity {
  REVIEW
  BLOCK
}

enum DevicePlatform {
  ANDROID
  IOS
}

enum DeviceProvider {
  EXPO
}

enum NotificationType {
  NEW_OFFER
  NEW_MESSAGE
  MODERATION_RESULT
  AD_EXPIRING
}

enum NotificationJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String     @unique @db.VarChar(320)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  authVersion  Int        @default(0) @map("auth_version")
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile         Profile?
  sessions        Session[]
  ads             Ad[]
  offers          Offer[]
  favorites       Favorite[]
  blocksCreated   Block[]       @relation("Blocker")
  blocksReceived  Block[]       @relation("Blocked")
  reportsCreated  Report[]      @relation("ReportReporter")
  reportsAgainst  Report[]      @relation("ReportUserTarget")
  reportsResolved Report[]      @relation("ReportResolver")
  auditLogs       AuditLog[]
  deviceTokens    DeviceToken[]
  sentMessages    Message[]
  moderationTerms ModerationTerm[]
  notificationJobs NotificationJob[]

  @@index([status])
  @@map("users")
}

model Session {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(255)
  rotatedFromId    String?   @unique @map("rotated_from_id") @db.Uuid
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rotatedFrom Session? @relation("SessionRotation", fields: [rotatedFromId], references: [id], onDelete: SetNull)
  rotatedTo   Session? @relation("SessionRotation")

  @@index([userId, expiresAt])
  @@index([userId, revokedAt])
  @@map("sessions")
}

model Profile {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  cityId    String?  @map("city_id") @db.Uuid
  nickname  String   @db.VarChar(50)
  language  String   @default("ru") @db.VarChar(5)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  city City? @relation(fields: [cityId], references: [id], onDelete: SetNull)

  @@index([cityId])
  @@map("profiles")
}

model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String   @unique @db.VarChar(80)
  nameRu    String   @map("name_ru") @db.VarChar(100)
  position  Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  ads Ad[]

  @@index([isActive, position])
  @@map("categories")
}

model City {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String   @unique @db.VarChar(100)
  nameRu    String   @map("name_ru") @db.VarChar(100)
  regionRu  String   @map("region_ru") @db.VarChar(120)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  profiles Profile[]
  ads      Ad[]

  @@index([isActive, nameRu])
  @@index([regionRu, nameRu])
  @@map("cities")
}

model Ad {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId     String        @map("owner_id") @db.Uuid
  categoryId  String        @map("category_id") @db.Uuid
  cityId      String        @map("city_id") @db.Uuid
  title       String        @db.VarChar(120)
  description String        @db.Text
  budget      Decimal?      @db.Decimal(14, 2)
  currency    String        @default("KZT") @db.Char(3)
  condition   ItemCondition @default(ANY)
  status      AdStatus      @default(DRAFT)
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(3)
  expiresAt   DateTime?     @map("expires_at") @db.Timestamptz(3)
  closedAt    DateTime?     @map("closed_at") @db.Timestamptz(3)
  moderationMatches Json?   @map("moderation_matches") @db.JsonB
  moderationNote String?    @map("moderation_note") @db.VarChar(2000)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  category  Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  city      City       @relation(fields: [cityId], references: [id], onDelete: Restrict)
  offers    Offer[]
  favorites Favorite[]
  reports   Report[]

  @@index([ownerId, createdAt, id])
  @@index([ownerId, status, createdAt, id])
  @@index([status, createdAt, id])
  @@index([categoryId, cityId, status, createdAt, id])
  @@index([expiresAt])
  @@map("ads")
}

model Offer {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adId        String      @map("ad_id") @db.Uuid
  senderId    String      @map("sender_id") @db.Uuid
  price       Decimal?    @db.Decimal(14, 2)
  currency    String      @default("KZT") @db.Char(3)
  description String?     @db.VarChar(1000)
  status      OfferStatus @default(PENDING)
  decidedAt   DateTime?   @map("decided_at") @db.Timestamptz(3)
  withdrawnAt DateTime?   @map("withdrawn_at") @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  ad      Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  sender  User     @relation(fields: [senderId], references: [id], onDelete: Restrict)
  reports Report[]
  chat    Chat?

  @@unique([adId, senderId])
  @@index([adId, status, createdAt])
  @@index([senderId, status, createdAt])
  @@map("offers")
}

model Chat {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  offerId       String    @unique @map("offer_id") @db.Uuid
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  offer    Offer     @relation(fields: [offerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([updatedAt, id])
  @@map("chats")
}

model Message {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chatId    String    @map("chat_id") @db.Uuid
  senderId  String    @map("sender_id") @db.Uuid
  body      String    @db.VarChar(2000)
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([chatId, createdAt, id])
  @@index([chatId, readAt, senderId])
  @@map("messages")
}

model Favorite {
  userId    String   @map("user_id") @db.Uuid
  adId      String   @map("ad_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  ad   Ad   @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@id([userId, adId])
  @@index([adId])
  @@map("favorites")
}

model Block {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model Report {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId     String           @map("reporter_id") @db.Uuid
  targetType     ReportTargetType @map("target_type")
  reportedUserId String?          @map("reported_user_id") @db.Uuid
  adId           String?          @map("ad_id") @db.Uuid
  offerId        String?          @map("offer_id") @db.Uuid
  reason         String           @db.VarChar(80)
  details        String?          @db.VarChar(2000)
  status         ReportStatus     @default(OPEN)
  resolutionNote String?          @map("resolution_note") @db.VarChar(2000)
  resolvedById   String?          @map("resolved_by_id") @db.Uuid
  resolvedAt     DateTime?        @map("resolved_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  reporter     User   @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  reportedUser User?  @relation("ReportUserTarget", fields: [reportedUserId], references: [id], onDelete: Restrict)
  ad           Ad?    @relation(fields: [adId], references: [id], onDelete: Restrict)
  offer        Offer? @relation(fields: [offerId], references: [id], onDelete: Restrict)
  resolvedBy   User?  @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@index([reportedUserId])
  @@index([adId])
  @@index([offerId])
  @@map("reports")
}

model ModerationTerm {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  term           String             @db.VarChar(200)
  normalizedTerm String             @unique @map("normalized_term") @db.VarChar(200)
  severity       ModerationSeverity @default(REVIEW)
  isActive       Boolean            @default(true) @map("is_active")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById    String?            @map("created_by_id") @db.Uuid

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isActive, severity])
  @@index([createdById])
  @@map("moderation_terms")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String?  @map("entity_id") @db.Uuid
  metadata   Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model DeviceToken {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  token      String         @unique @db.Text
  platform   DevicePlatform
  provider   DeviceProvider @default(EXPO)
  isEnabled  Boolean        @default(true) @map("is_enabled")
  lastSeenAt DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isEnabled])
  @@map("device_tokens")
}

model NotificationJob {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId   String                @map("recipient_id") @db.Uuid
  type          NotificationType
  status        NotificationJobStatus @default(PENDING)
  dedupeKey     String                @unique @map("dedupe_key") @db.VarChar(200)
  data          Json?                 @db.JsonB
  attempts      Int                   @default(0)
  nextAttemptAt DateTime?             @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lockedAt      DateTime?             @map("locked_at") @db.Timestamptz(3)
  sentAt        DateTime?             @map("sent_at") @db.Timestamptz(3)
  lastError     String?               @map("last_error") @db.VarChar(500)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt, createdAt])
  @@index([recipientId, createdAt])
  @@map("notification_jobs")
}
