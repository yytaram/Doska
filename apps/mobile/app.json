{
  "expo": {
    "name": "Doska",
    "slug": "doska",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "doska",
    "android": {
      "package": "com.doska.app"
    },
    "ios": {
      "bundleIdentifier": "com.doska.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
