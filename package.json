{
  "name": "doska",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "lint": "eslint apps packages --max-warnings=0",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "mobile:start": "pnpm --filter @doska/mobile start",
    "mobile:android": "pnpm --filter @doska/mobile android",
    "mobile:ios": "pnpm --filter @doska/mobile ios",
    "api:dev": "pnpm --filter @doska/api dev",
    "admin:dev": "pnpm --filter @doska/admin dev",
    "db:health": "pnpm --filter @doska/api db:health",
    "db:generate": "pnpm --filter @doska/api db:generate",
    "db:migrate": "pnpm --filter @doska/api db:migrate",
    "db:deploy": "pnpm --filter @doska/api db:deploy",
    "db:seed": "pnpm --filter @doska/api db:seed",
    "db:reset": "pnpm --filter @doska/api db:reset",
    "test": "pnpm --recursive --if-present run test",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "services:logs": "docker compose logs -f",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "eslint": "^9.38.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
